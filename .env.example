# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Para descobrir seu username: publique qualquer prompt no LangSmith Hub, depois abra-o e clique no ícone de cadeado (🔒) para ver seu username.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# LLM Configuration
#
# O projeto suporta três configurações. Descomente apenas UMA delas.
# ---------------------------------------------------------------------------

# 1) Ollama local (padrão deste projeto, custo zero)
#    O Ollama expõe uma API compatível com OpenAI, então usamos LLM_PROVIDER=openai
#    e redirecionamos o ChatOpenAI para o servidor local via OPENAI_API_BASE.
#    OPENAI_API_KEY pode ser qualquer valor: o Ollama não valida a chave.
LLM_PROVIDER=openai
LLM_MODEL=qwen3.8:27b
EVAL_MODEL=qwen3.8:27b
OPENAI_API_BASE=http://localhost:11434/v1

# 2) Google Gemini (free tier)
#LLM_PROVIDER=google
#LLM_MODEL=gemini-2.5-flash
#EVAL_MODEL=gemini-2.5-flash

# 3) OpenAI (pago)
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o
#OPENAI_API_BASE=https://api.openai.com/v1
